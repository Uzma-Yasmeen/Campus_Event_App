# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/campus_events
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus_events
MONGO_URI=mongodb://127.0.0.1:27017/campus_events

# Secret used to sign JWTs. Generate a long random value for anything public:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port the API listens on. Hosting platforms usually set this themselves.
PORT=5000

# Set to "production" when deployed. This turns on the CORS allowlist below
# and stops internal error messages being returned to clients.
NODE_ENV=development

# Comma-separated list of origins allowed to call the API from a browser.
# Only enforced when NODE_ENV=production. No trailing slashes.
# CORS_ORIGINS=https://campus-events.netlify.app,https://events.example.edu

# Number of proxies in front of the app. Set to 1 on Render, Railway, Heroku
# and similar, so rate limiting sees the real client IP rather than the proxy.
# TRUST_PROXY=1
